# .env.example — Worker environment (copy to .env for local runs; never commit real secrets).
# Names MUST match the shared conventions exactly.

# Postgres connection string (node-postgres).
DATABASE_URL=postgres://wwwp:wwwp@localhost:5432/wwwp

# Public app URL (used in "poster ready" emails / links).
APP_URL=https://wildwestwanted.com

# AWS
AWS_REGION=us-west-2
S3_UPLOAD_BUCKET=wwwp-uploads
S3_POSTER_BUCKET=wwwp-posters
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/000000000000/wwwp-generations

# Email (SES)
SES_FROM_EMAIL=noreply@wildwestwanted.com

# Google Gemini (image generation)
GEMINI_API_KEY=your-gemini-api-key

# Auth / admin (shared with web; worker reads ADMIN_EMAILS only for monthly reset audience notes)
AUTH_SECRET=dev-only-change-me
ADMIN_EMAILS=ryanbyrd@gmail.com

# Stripe (not used by the worker, listed for parity with the shared env contract)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREDITS=
