# .env.example — copy to .env.local for dev. Real values come from AWS Secrets Manager via ECS. Ch 34 secrets.
# Never commit real secrets.

# Postgres connection string (RDS PostgreSQL 16)
DATABASE_URL=postgres://wwwp:password@localhost:5432/wwwp

# Public base URL of the app (used for magic links + Stripe redirects)
APP_URL=https://wildwestwanted.com

# AWS
AWS_REGION=us-west-2
S3_UPLOAD_BUCKET=wwwp-uploads
S3_POSTER_BUCKET=wwwp-posters
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/000000000000/wwwp-generations

# Email (AWS SES)
SES_FROM_EMAIL=noreply@wildwestwanted.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CREDITS=price_xxx

# Google Gemini (worker uses this; web does not generate images)
GEMINI_API_KEY=

# Auth: secret used to sign session JWTs (min 32 bytes)
AUTH_SECRET=change-me-to-a-long-random-string-min-32-bytes

# Comma-separated admin emails (granted is_admin on first login)
ADMIN_EMAILS=ryanbyrd@gmail.com
