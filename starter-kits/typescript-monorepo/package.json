{
  "name": "ts-monorepo-starter",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native TypeScript monorepo starter — companion to Software Engineering with AI by Ryan Byrd",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify": "bash scripts/verify.sh",
    "lint": "eslint 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "typecheck": "tsc -b",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
